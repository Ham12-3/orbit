# Copy to `.env.local` (make install does this and fills in the token).
# Server-side only (no NEXT_PUBLIC_ prefix): the Next.js server forwards browser requests to
# the backend and adds the token, so the browser never sees it.
ORBIT_API_URL=http://localhost:8000
# Must equal LOCAL_API_TOKEN in the repo-root .env.
ORBIT_API_TOKEN=
