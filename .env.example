# Backend + infra settings. Copy to `.env` (make install does this and fills in
# generated secrets) and fill in the rest. The frontend has its own frontend/.env.example.

# --- App ---
ORBIT_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Database (docker-compose Postgres) ---
DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit
TEST_DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit_test

# --- Inngest ---
# 1 = talk to the local Dev Server (http://localhost:8288). Never set in production.
INNGEST_DEV=1
# Production only (Inngest Cloud). Not needed with the Dev Server.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Dashboard auth (Phase 1 stand-in until Supabase in Phase 2) ---
# Generated by make install. Send as: Authorization: Bearer <DEV_API_TOKEN>
DEV_API_TOKEN=

# --- Public URL of this backend (Microsoft Dev Tunnel) ---
# Bot sandboxes call it for the LLM proxy and run callbacks. `make tunnel-setup` fills in
# both values; `make dev` hosts the tunnel. Needs: winget install Microsoft.devtunnel,
# then devtunnel user login.
DEVTUNNEL_ID=
PUBLIC_BASE_URL=

# --- Anthropic (only the backend's LLM proxy uses this; sandboxes never see it) ---
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-sonnet-5-5
BACKGROUND_MODEL=claude-haiku-5-5

# --- E2B ---
E2B_API_KEY=
E2B_TEMPLATE=orbit-bot

# --- Runs ---
# Signs short-lived run tokens (min 32 chars). Generated by make install.
RUN_TOKEN_SECRET=
RUN_TIMEOUT_S=1800
