# Backend + infra settings. Copy to `.env` (make install does this) and fill in.
# The frontend has its own file: frontend/.env.example.

# --- App ---
ORBIT_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Database (docker-compose Postgres) ---
DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit
TEST_DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit_test

# --- Inngest ---
# true = talk to the local Dev Server (http://localhost:8288). Never true in production.
INNGEST_DEV=true
# Production only (Inngest Cloud). Not needed with the Dev Server.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
